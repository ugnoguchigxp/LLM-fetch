{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-background-fetch",
  "version": "0.1.0",
  "identifier": "dev.llm-fetch.example",
  "build": { "frontendDist": "./dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "llm-fetch example",
      "width": 800,
      "height": 600,
      "visible": false,
      "focus": false,
      "focusable": false,
      "closable": false,
      "skipTaskbar": true,
      "alwaysOnTop": false
    }]
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] },
  "plugins": { "llm-fetch": { "requireReliableBackground": true } }
}
